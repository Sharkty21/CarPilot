<Project Sdk="Aspire.AppHost.Sdk/13.5.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>a456165b-b1aa-4400-b4a3-12f2de622316</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIREACANAMING001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarPilot.Server\CarPilot.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="postgres\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="postgres-init\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.5.2" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.5.2" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.2" />
    <PackageReference Include="Aspire.Hosting.Python" Version="13.5.2" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.RustFs" Version="13.5.0-beta.730" />
  </ItemGroup>
</Project>
